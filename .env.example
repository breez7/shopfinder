# ShopFinder environment variables (all optional — most can be set via /settings UI after first boot)

# --- Server ---
SHOPFINDER_HOST=0.0.0.0
SHOPFINDER_PORT=8080
SHOPFINDER_DB_PATH=./data/shopfinder.db
SHOPFINDER_SECRET_KEY=change-me-to-a-random-string

# --- Naver Shopping Open API (https://developers.naver.com/apps) ---
# Required for the Naver adapter. Can also be set in the /settings UI.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- OpenAI-compatible LLM (default assumption: LM Studio on the LAN) ---
# Example: http://192.168.0.10:1234/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Optional Playwright fallback (Phase 3) ---
ENABLE_PLAYWRIGHT=0
