# syntax=docker/dockerfile:1.7
# Optional image variant with Playwright + Chromium for JS-heavy adapters.
# Memory budget on Pi 4 (4 GB): adds ~300-500 MB RSS while a page renders.
# Not the default — use `docker compose -f docker-compose.yml -f docker-compose.playwright.yml up`.

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    SHOPFINDER_DB_PATH=/data/shopfinder.db \
    ENABLE_PLAYWRIGHT=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

FROM base AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY app ./app
COPY README.md ./
RUN pip install --prefix=/install . playwright

FROM base AS runtime

# Install Chromium and its system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
        libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
        libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
        libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
COPY app ./app
COPY README.md ./

RUN python -m playwright install chromium

RUN mkdir -p /data && useradd --uid 1000 --create-home shopfinder \
    && chown -R shopfinder:shopfinder /data /app /ms-playwright
USER shopfinder

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2)" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
